# ============================================
# ATHRag 部署配置
# 复制此文件为 .env 并修改对应值
# cp .env.example .env
# ============================================

# === 认证 ===
AUTH_ENABLED=true
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ADMIN_USERNAME=admin
# 密码（首次启动时自动哈希，或直接设置 ADMIN_PASSWORD_HASH）
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Ollama ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=bge-m3
OLLAMA_SUMMARY_MODEL=qwen3.5:9b
OLLAMA_COMPRESS_MODEL=qwen3.5:4b
OLLAMA_EMBED_DIM=1024

# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=project_

# === 服务 ===
APP_HOST=0.0.0.0
APP_PORT=16250
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# === 数据目录 ===
DATA_DIR=./data
PROJECTS_DIR=./data/projects
VECTOR_DB_DIR=./data/vector_db
DB_PATH=./db/metadata.db

# === 分块 ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
MAX_CHUNK_SIZE=2000
MIN_CHUNK_SIZE=300

# === 检索 ===
SEARCH_TOP_K=40
SEARCH_SCORE_THRESHOLD=0.7
SEARCH_RERANK_TOP_K=20

# === Worker 并发 ===
WORKER_BATCH_SIZE=3
WORKER_POLL_INTERVAL=2.0
WORKER_TASK_TIMEOUT=600
EMBED_CONCURRENCY=3

# === Watcher ===
# WATCHER_ROOT=/path/to/your/project/root

# === MinerU (可选) ===
MINERU_DEVICE=mps
# MINERU_CONFIG_PATH=~/.mineru/magic-pdf.json
